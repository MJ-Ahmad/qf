  "chapters": [
    {
      "icon": "research",
      "title": {
        "bn": "গবেষণা",
        "en": "Research"
      },
      "text": {
        "bn": "কোরআনের গভীরতা অনুধাবনে প্রাচীন জ্ঞান ও আধুনিক বিশ্লেষণের মেলবন্ধন।",
        "en": "Bridging classical scholarship with modern analysis to understand the Quran in depth."
      },
      "link": "/qf/edu.html"
    },
    {
      "icon": "printing",
      "title": {
        "bn": "মুদ্রণ",
        "en": "Printing"
      },
      "text": {
        "bn": "প্রি-প্রেস থেকে বাঁধাই পর্যন্ত প্রতিটি ধাপে নিখুঁততা—যাতে প্রতিটি কপি মর্যাদার সঙ্গে পাঠকের কাছে পৌঁছে।",
        "en": "Precision at every stage, from pre-press to binding, so each copy reaches its reader with dignity."
      },
      "link": "/qf/pr.html"
    },
    {
      "icon": "distribution",
      "title": {
        "bn": "বিতরণ",
        "en": "Distribution"
      },
      "text": {
        "bn": "মাদ্রাসা, এতিমখানা ও শরণার্থী শিবিরসহ দেশের প্রতিটি বিভাগে কোরআন পৌঁছে দেওয়া।",
        "en": "Delivering copies to madrasas, orphanages, refugee camps, and communities across the country."
      },
      "link": "/qf/ds.html"
    }
  ],

